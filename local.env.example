# 本地配置模板。复制为 local.env 后填入自己的值：
#     copy local.env.example local.env
#
# local.env 已在 .gitignore 里，不会被提交。
# 本文件（.example）会入库，所以**绝不要在这里写真实凭据**。
#
# 详细说明见 docs/CONFIG.md。
# 两块都不配也能完整跑：走离线策略决策 + 内存记忆。

# ---------- LLM ----------
# mock（默认，不联网）/ ark（火山方舟）/ openai
LLM_PROVIDER=mock

# 火山方舟
#ARK_API_KEY=
#ARK_MODEL=
#ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenAI 或兼容接口
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1

# 测评判官（不写则跟随上面的 LLM 配置）
#JUDGE_PROVIDER=ark
#JUDGE_MODEL=

# ---------- Postgres ----------
# 建账号：psql -U postgres -f docs/postgres_init.sql
# 不配则记忆只存内存，重启丢失
#DATABASE_URL=postgresql://shopping_agent:你的密码@localhost:5432/shopping_agent

# ---------- 数据源 ----------
# mock 跑本地样本；live 走真实适配器
DATA_SOURCE_MODE=mock
