# 本地配置模板。复制为 local.env 后填入自己的值：
#     copy local.env.example local.env
#
# local.env 已在 .gitignore 里，不会被提交。
# 本文件（.example）会入库，所以**绝不要在这里写真实凭据**。
#
# 详细说明见 docs/CONFIG.md。
# 两块都不配也能完整跑：走离线策略决策 + 内存记忆。

# ---------- LLM ----------
# mock（默认，不联网）/ ark（火山方舟）/ openai
LLM_PROVIDER=mock

# 火山方舟
#ARK_API_KEY=
#ARK_MODEL=
#ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenAI 或兼容接口
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1

# 测评判官（不写则跟随上面的 LLM 配置）
#JUDGE_PROVIDER=ark
#JUDGE_MODEL=

# ---------- Postgres ----------
# 建账号：psql -U postgres -f docs/postgres_init.sql
# 不配则记忆只存内存，重启丢失
#DATABASE_URL=postgresql://shopping_agent:你的密码@localhost:5432/shopping_agent

# ---------- 数据源 ----------
# mock 跑本地样本；live 走真实适配器
DATA_SOURCE_MODE=mock

# ---------- 对照实现开关（默认全关） ----------
# 这四项在当前项目规模下是净负收益（理由见 README 第 5 章），
# 所以做成可切换的对照实现：默认走经过完整回归的那条路径，
# 打开开关即切换到对照实现，可直接对比效果与开销。
# 打开后如果依赖缺失会明确报错，不会静默退回。
#
# 用 LangGraph 的 StateGraph 编排主循环（代价：流式退化成批式）
#USE_LANGGRAPH=0
# 工具层通过 MCP 协议暴露/调用（代价：多一层序列化，无功能增益）
#USE_MCP=0
# 跨品类对比时为每个品类起一个子 agent（代价：token 约等于品类数倍数）
#USE_MULTI_AGENT=0
# 系统提示词追加 few-shot 示例（实测代价：325 -> 712 tokens，+119%）
#USE_FEW_SHOT=0
